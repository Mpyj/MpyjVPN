<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MpyjVPN.UI.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://MpyjVPN.UI/Styles/AppStyles.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MpyjVPN.UI/Styles/DarkTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Font with Emoji support -->
            <FontFamily x:Key="DefaultFont">Segoe UI, Segoe UI Emoji, Arial</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
