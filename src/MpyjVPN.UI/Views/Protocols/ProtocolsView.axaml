<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MpyjVPN.Application.ViewModels;assembly=MpyjVPN.Application"
             x:Class="MpyjVPN.UI.Views.Protocols.ProtocolsView"
             x:CompileBindings="False"
             FontFamily="Segoe UI Emoji, Segoe UI">

    <StackPanel Spacing="24">

        <StackPanel>
            <TextBlock Text="Protocols" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Manage active protocols" FontSize="13"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto">

            <Border Grid.Column="0" Classes="GlassCard" Margin="0,0,10,0">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="ProtocolSearch"
                                 Watermark="🔍 Search protocols..."
                                 Grid.Column="0"
                                 Padding="12"
                                 Background="{DynamicResource InputBgBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 CornerRadius="12"
                                 Foreground="{DynamicResource TextBrush}"
                                 FontSize="13"/>
                        <Button x:Name="RefreshButton" Grid.Column="1"
                                Content="🔄"
                                Margin="10,0,0,0"
                                Padding="14,10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Foreground="{DynamicResource TextBrush}"
                                Click="OnRefreshProtocols"/>
                    </Grid>

                    <Border Background="{DynamicResource CodeBgBrush}"
                            CornerRadius="12"
                            Padding="4"
                            MinHeight="400"
                            MaxHeight="500">
                        <ScrollViewer>
                            <ItemsControl x:Name="ProtocolsList" ItemsSource="{Binding Protocols}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProtocolViewModel">
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="OnProtocolClick">
                                            <Border Background="Transparent"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="12,10">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                               FontSize="20" VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                                   Foreground="{DynamicResource TextDimBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Ping}"
                                                               FontSize="11" FontFamily="Consolas"
                                                               Foreground="{DynamicResource CyanBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0" MinWidth="50"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Status}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <CheckBox Grid.Column="4"
                                                              IsChecked="{Binding IsEnabled}"
                                                              VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Width="340" Classes="GlassCard">
                <StackPanel Spacing="16">
                    <StackPanel x:Name="DetailEmpty"
                                Spacing="12"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,80,0,0"
                                IsVisible="True">
                        <TextBlock Text="👈" FontSize="48"
                                   HorizontalAlignment="Center" Opacity="0.3"/>
                        <TextBlock x:Name="DetailEmptyText"
                                   Text="Select a protocol" FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="DetailContent" Spacing="16" IsVisible="False">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock x:Name="DetailIcon" Text="🌐"
                                       FontSize="48" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DetailName" Text="WARP"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DetailDescription" Text=""
                                       FontSize="12"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Border Background="{DynamicResource InputBgBrush}"
                                CornerRadius="12" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="Status:" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" Width="80"/>
                                    <TextBlock Grid.Column="1" x:Name="DetailStatus"
                                               Text="⭕ Inactive" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextDimBrush}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="Ping:" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" Width="80"/>
                                    <TextBlock Grid.Column="1" x:Name="DetailPing"
                                               Text="--" FontSize="12"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource CyanBrush}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="Type:" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" Width="80"/>
                                    <TextBlock Grid.Column="1" x:Name="DetailType"
                                               Text="Built-in" FontSize="12"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="Port:" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" Width="80"/>
                                    <TextBlock Grid.Column="1" x:Name="DetailPort"
                                               Text="443" FontSize="12"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button x:Name="TestPingButton"
                                Content="🧪 Test Ping"
                                Padding="12,10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Foreground="{DynamicResource TextBrush}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="OnTestPing"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
