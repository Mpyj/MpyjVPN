<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Background -->
    <SolidColorBrush x:Key="BgBrush" Color="#f5f5f7"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#ebebef"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#f0f0f4"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#d8d8e0"/>
    <SolidColorBrush x:Key="CodeBgBrush" Color="#fafafa"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#ffffff"/>
    
    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#1a1a2e"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#5a5a70"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9090a8"/>
    
    <!-- Accent -->
    <SolidColorBrush x:Key="CyanBrush" Color="#0099cc"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#059669"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#d97706"/>
    <SolidColorBrush x:Key="RedBrush" Color="#dc2626"/>
    
</ResourceDictionary>