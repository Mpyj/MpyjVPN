<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MpyjVPN.Avalonia.Views.ImportConfigWindow"
        Title="Import Config"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BgBrush}"
        TransparencyLevelHint="Mica">
    
    <Border Background="{DynamicResource BgBrush}" Padding="0">
        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,18">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="📥" FontSize="24" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Import Config" 
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Paste a link, JSON, or subscription URL"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <Button Grid.Column="1"
                            Content="&#x2715;"
                            Width="32" Height="32"
                            Padding="0"
                            FontSize="16"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextDimBrush}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OnCloseClick"/>
                </Grid>
            </Border>
            
            <!-- Body -->
            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="24" Spacing="20">
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="&#x1F4CB; Config (link, JSON, or subscription URL)"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDimBrush}"/>
                        
                        <TextBox x:Name="ConfigInput"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="140"
                                 MaxHeight="200"
                                 Padding="12"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Background="{DynamicResource InputBgBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 CornerRadius="10"
                                 Foreground="{DynamicResource TextBrush}"
                                 Watermark="vmess://... یا https://.../sub/raw"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="🏷️ Name prefix (optional)"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDimBrush}"/>
                        
                        <TextBox x:Name="NameInput"
                                 Padding="12"
                                 Background="{DynamicResource InputBgBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 CornerRadius="10"
                                 Foreground="{DynamicResource TextBrush}"
                                 Watermark="My Server"/>
                    </StackPanel>
                    
                    <!-- Error -->
                    <Border x:Name="ErrorBox"
                            IsVisible="False"
                            Background="#2a0a0a"
                            BorderBrush="#ef4444"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#x274C;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ErrorText"
                                       Text=""
                                       FontSize="12"
                                       Foreground="#ef4444"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Loading -->
                    <Border x:Name="LoadingBox"
                            IsVisible="False"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource CyanBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#x23F3;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LoadingText"
                                       Text="Downloading..."
                                       FontSize="12"
                                       Foreground="{DynamicResource CyanBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Supported -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="&#x2705; Supported:"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       LetterSpacing="1"/>
                            <TextBlock Text="• VMess  • VLess  • Trojan  • SS"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Text="• JSON  • Subscription URL"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource TextDimBrush}"/>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,16">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Press Ctrl+V to paste"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    
                    <Button Grid.Column="1"
                            Content="Cancel"
                            Margin="0,0,8,0"
                            Padding="20,10"
                            Background="{DynamicResource InputBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Foreground="{DynamicResource TextBrush}"
                            Click="OnCancelClick"/>
                    
                    <Button x:Name="ImportButton"
                            Grid.Column="2"
                            Content="&#x2705; Import"
                            Padding="20,10"
                            Background="{DynamicResource CyanBrush}"
                            BorderThickness="0"
                            CornerRadius="10"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="OnImportClick"/>
                </Grid>
            </Border>
            
        </Grid>
    </Border>
</Window>